---
import { siteTitle } from '../lib/site';

type Props = { title: string; description?: string; nav?: [string, string][]; current?: string; robots?: string };
const { title, description, nav = [], current, robots } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    {robots && <meta name="robots" content={robots} />}
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
    <link rel="icon" href="data:," />
  </head>
  <body>
    <header class="bar">
      <a class="brand" href="/">{robots ? 'Protected site' : siteTitle}</a>
      {nav.length > 1 && <nav aria-label="Pages">{nav.map(([href, label]) => <a href={href} aria-current={href === current ? 'page' : undefined}>{label}</a>)}</nav>}
    </header>
    <main id="main"><slot /></main>
  </body>
</html>
<style is:global>
  :root { --bg: #f4f5f7; --surface: #ffffff; --ink: #111318; --soft: #3b3f48; --mute: #5b616e; --line: rgba(17, 19, 24, .1); --accent: #2f55e0; color-scheme: light dark; }
  @media (prefers-color-scheme: dark) { :root { --bg: #0f0f10; --surface: #1a1a1c; --ink: #f3f3f1; --soft: #cacac6; --mute: #9d9d99; --line: rgba(255, 255, 255, .1); --accent: #b8f26c; } }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 17px/1.65 ui-sans-serif, system-ui, sans-serif; }
  .bar { max-width: 760px; margin: 0 auto; padding: 22px 20px 0; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 24px; }
  .brand { font-weight: 650; letter-spacing: -.01em; color: var(--ink); text-decoration: none; }
  nav { display: flex; gap: 6px; flex-wrap: wrap; }
  nav a { color: var(--soft); text-decoration: none; padding: 6px 12px; border-radius: 999px; font-size: 15px; }
  nav a:hover, nav a[aria-current='page'] { background: var(--surface); color: var(--ink); box-shadow: inset 0 0 0 1px var(--line); }
  main { max-width: 760px; margin: 0 auto; padding: clamp(28px, 6vw, 64px) 20px 80px; }
  h1 { font-size: clamp(32px, 5vw, 48px); line-height: 1.08; letter-spacing: -.025em; margin: 0 0 22px; }
  h2 { font-size: 22px; letter-spacing: -.01em; margin: 40px 0 10px; }
  a { color: var(--accent); }
  img { max-width: 100%; height: auto; border-radius: 12px; }
  code { font-size: .9em; background: var(--surface); padding: 2px 6px; border-radius: 6px; box-shadow: inset 0 0 0 1px var(--line); }
  .note { color: var(--mute); font-size: 15px; }
  form { display: flex; flex-wrap: wrap; gap: 8px; margin: 24px 0 8px; }
  label { flex-basis: 100%; color: var(--mute); font-size: 14px; }
  input, button { font: inherit; height: 48px; border-radius: 12px; border: 1px solid var(--line); padding: 0 16px; background: var(--surface); color: var(--ink); }
  input { flex: 1 1 260px; }
  button { background: var(--ink); color: var(--bg); border: 0; padding: 0 22px; cursor: pointer; font-weight: 600; }
  .quiet { background: transparent; color: var(--mute); height: 36px; padding: 0 12px; font-weight: 500; box-shadow: inset 0 0 0 1px var(--line); }
  input:focus-visible, button:focus-visible, a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>
